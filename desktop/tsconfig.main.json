{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    /* The main and preload processes run in Node under Electron, so they are
       emitted as CommonJS rather than left for a bundler. */
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/main", "src/shared"],
  "exclude": ["src/main/__tests__/**"]
}
